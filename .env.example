# Convex deployment URL; the MCP server calls its HTTP API on .convex.site
CONVEX_URL=https://<name>.convex.cloud
# Or the HTTP API base directly, e.g. a local backend:
# CONVEX_SITE_URL=http://127.0.0.1:3211
# Must match YOUTWO_API_TOKEN on the deployment (npx convex env set YOUTWO_API_TOKEN ...)
YOUTWO_API_TOKEN=
